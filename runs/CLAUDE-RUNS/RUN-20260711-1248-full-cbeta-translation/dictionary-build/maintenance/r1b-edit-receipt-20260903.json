  "editRecords": [
    {
      "class": "occ-remove-retired",
      "entry": "t_022d58242948",
      "si": 1,
      "oi": 4,
      "relPath": "T/T48/T48n2023.xml",
      "kwicHead": "旨趣應須。博問先知將謂出家。貴求衣食佛先制律。啟",
      "masterName": "Guishan Lingyou"
    },
    {
      "class": "occ-remove-retired",
      "entry": "t_044652c7b411",
      "si": 1,
      "oi": 2,
      "relPath": "X/X63/X63n1245.xml",
      "kwicHead": "暫到相看。知客出。各觸禮三拜。暫到辭云。此際經過",
      "masterName": null
    },
    {
      "class": "occ-remove-retired",
      "entry": "t_05659eb4122a",
      "si": 1,
      "oi": 2,
      "relPath": "T/T48/T48n2023.xml",
      "kwicHead": "難追。教理未嘗措懷。玄道無因契悟。及至年高臈長。",
      "masterName": "Guishan Lingyou"
    },
    {
      "class": "occ-remove-retired",
      "entry": "t_0c53a5a2243b",
      "si": 1,
      "oi": 3,
      "relPath": "X/X63/X63n1245.xml",
      "kwicHead": "知客出。",
      "masterName": null
    },
    {
      "class": "occ-remove-retired",
      "entry": "t_1383f942789d",
      "si": 1,
      "oi": 6,
      "relPath": "X/X63/X63n1245.xml",
      "kwicHead": "大禮三拜。胡跪合掌。善男子。汝既捨邪歸正。戒已周",
      "masterName": null
    },
    {
      "class": "occ-remove-retired",
      "entry": "t_13951a5b5260",
      "si": 1,
      "oi": 1,
      "relPath": "X/X63/X63n1245.xml",
      "kwicHead": "第二卷上堂念誦小參結夏解夏冬年人事巡寮迎接請知事",
      "masterName": null
    },
    {
      "class": "occ-remove-retired",
      "entry": "t_1b94d664ca7a",
      "si": 1,
      "oi": 1,
      "relPath": "X/X63/X63n1245.xml",
      "kwicHead": "問訊立也。知客引施主在知事上肩立。以上主事從",
      "masterName": null
    },
    {
      "class": "occ-remove-retired",
      "entry": "t_32289452a85b",
      "si": 1,
      "oi": 3,
      "relPath": "T/T48/T48n2023.xml",
      "kwicHead": "方便偷蘭燒指然香。",
      "masterName": null
    },
    {
      "class": "occ-remove-retired",
      "entry": "t_36b1824beee5",
      "si": 1,
      "oi": 3,
      "relPath": "X/X63/X63n1245.xml",
      "kwicHead": "卷上堂念誦小參結夏解夏冬年人事巡寮迎接請知事第三",
      "masterName": null
    },
    {
      "class": "occ-remove-retired",
      "entry": "t_3b9857d1cc19",
      "si": 1,
      "oi": 3,
      "relPath": "X/X63/X63n1245.xml",
      "kwicHead": "點通眾煎點燒香法置食特為謝茶看藏經中筵齋出入警眾",
      "masterName": null
    },
    {
      "class": "occ-remove-retired",
      "entry": "t_41476f956295",
      "si": 1,
      "oi": 3,
      "relPath": "X/X63/X63n1245.xml",
      "kwicHead": "看藏主白之。茶罷。藏主引至經堂案位前。各觸禮一拜",
      "masterName": null
    },
    {
      "class": "occ-remove-retired",
      "entry": "t_428c42ea1c8f",
      "si": 1,
      "oi": 1,
      "relPath": "T/T48/T48n2023.xml",
      "kwicHead": "惡者長惡知見。曉夕造惡。即目交報歿後沈淪。一失人",
      "masterName": "Guishan Lingyou"
    },
    {
      "class": "occ-remove-retired",
      "entry": "t_4b1aa91dd297",
      "si": 1,
      "oi": 3,
      "relPath": "T/T48/T48n2023.xml",
      "kwicHead": "。嗔心忿起。便道佛法豈有與麼事。大悟不拘小節。更",
      "masterName": "Fachang Yiyu"
    },
    {
      "class": "occ-remove-retired",
      "entry": "t_4e0636f53520",
      "si": 1,
      "oi": 4,
      "relPath": "T/T48/T48n2023.xml",
      "kwicHead": "安籠占案不必著忙。欵細之間自然穩便。入寮煎點本為",
      "masterName": null
    },
    {
      "class": "occ-remove-retired",
      "entry": "t_50d75aeeeef1",
      "si": 1,
      "oi": 2,
      "relPath": "X/X63/X63n1245.xml",
      "kwicHead": "安排香火。",
      "masterName": null
    },
    {
      "class": "note-count-rewrite",
      "entry": "t_50d75aeeeef1",
      "si": 1,
      "before": "6 exact occurrences from 6 distinct works",
      "after": "5 exact occurrences from 5 distinct works",
      "postOccurrences": 5,
      "postDistinctRels": 5
    },
    {
      "class": "occ-remove-retired",
      "entry": "t_5306489d35c6",
      "si": 1,
      "oi": 2,
      "relPath": "X/X63/X63n1245.xml",
      "kwicHead": "化主化主或侍者寮具州縣名目出膀召請發心。或知事頭",
      "masterName": null
    },
    {
      "class": "occ-remove-retired",
      "entry": "t_5ab995298e4e",
      "si": 1,
      "oi": 2,
      "relPath": "T/T48/T48n2023.xml",
      "kwicHead": "禪師小參褒禪山慧空禪師輪藏記慈照聰禪師住石門查待",
      "masterName": null
    },
    {
      "class": "occ-remove-retired",
      "entry": "t_5b93919eced9",
      "si": 1,
      "oi": 4,
      "relPath": "T/T48/T48n2023.xml",
      "kwicHead": "休息。貪戀世間陰緣成質。從生至老一無所得。根本無",
      "masterName": null
    },
    {
      "class": "occ-remove-retired",
      "entry": "t_76ee526a2b16",
      "si": 1,
      "oi": 2,
      "relPath": "X/X63/X63n1245.xml",
      "kwicHead": "既受沙彌戒法。",
      "masterName": null
    },
    {
      "class": "occ-remove-retired",
      "entry": "t_88dac6848042",
      "si": 1,
      "oi": 2,
      "relPath": "X/X63/X63n1245.xml",
      "kwicHead": "人。亦當詣寮迴禮。若欲掛搭。歇一兩日。詣堂司相看",
      "masterName": null
    },
    {
      "class": "occ-remove-retired",
      "entry": "t_9ba11d160033",
      "si": 1,
      "oi": 1,
      "relPath": "X/X63/X63n1245.xml",
      "kwicHead": "苑清規目錄第一卷受戒護戒辨道具裝包旦過掛搭赴粥飰",
      "masterName": null
    },
    {
      "class": "occ-remove-retired",
      "entry": "t_a5ffef8b3f2d",
      "si": 1,
      "oi": 6,
      "relPath": "X/X63/X63n1245.xml",
      "kwicHead": "適奉堂頭和尚慈旨。令請某上座充某知事。",
      "masterName": null
    },
    {
      "class": "occ-remove-retired",
      "entry": "t_aa45c307e9f1",
      "si": 1,
      "oi": 1,
      "relPath": "X/X63/X63n1245.xml",
      "kwicHead": "頭首者謂首座書記藏主知客浴主。竝同已前和會知事之",
      "masterName": null
    },
    {
      "class": "occ-remove-retired",
      "entry": "t_acd15cd3ba91",
      "si": 1,
      "oi": 4,
      "relPath": "T/T48/T48n2023.xml",
      "kwicHead": "成者難。諸寮供過要精勤。掃地煎茶莫厭頻。事眾若能",
      "masterName": "Cishou Huaishen"
    },
    {
      "class": "occ-remove-retired",
      "entry": "t_b4c37e2f25c3",
      "si": 1,
      "oi": 4,
      "relPath": "X/X63/X63n1245.xml",
      "kwicHead": "重雕補註禪苑清規第六卷重雕補註禪苑清規第七卷大小",
      "masterName": null
    },
    {
      "class": "occ-remove-retired",
      "entry": "t_b97e19fa54b2",
      "si": 1,
      "oi": 1,
      "relPath": "X/X63/X63n1245.xml",
      "kwicHead": "首座率大眾坐堂。",
      "masterName": null
    },
    {
      "class": "occ-remove-retired",
      "entry": "t_bea7c499e294",
      "si": 1,
      "oi": 2,
      "relPath": "X/X63/X63n1245.xml",
      "kwicHead": "滅。今再寫作大字。刻梓以傳。收者幸鑒。嘉泰壬戌虞",
      "masterName": null
    },
    {
      "class": "occ-remove-retired",
      "entry": "t_c513dc22845c",
      "si": 1,
      "oi": 5,
      "relPath": "X/X63/X63n1245.xml",
      "kwicHead": "否證大涅槃否誡沙彌誡沙彌未披剃前。准備五條正合披",
      "masterName": null
    },
    {
      "class": "occ-remove-retired",
      "entry": "t_c945c2cc0e79",
      "si": 1,
      "oi": 8,
      "relPath": "T/T48/T48n2023.xml",
      "kwicHead": "結制小參佛祖門風將委地。說著令人心膽碎。",
      "masterName": null
    },
    {
      "class": "occ-remove-retired",
      "entry": "t_c968c2829eeb",
      "si": 1,
      "oi": 2,
      "relPath": "T/T48/T48n2023.xml",
      "kwicHead": "慈雲式懺主書紳願文",
      "masterName": null
    },
    {
      "class": "occ-remove-retired",
      "entry": "t_cf2b777134bb",
      "si": 1,
      "oi": 1,
      "relPath": "X/X63/X63n1245.xml",
      "kwicHead": "主寮首座堂頭侍者第五",
      "masterName": null
    },
    {
      "class": "occ-remove-retired",
      "entry": "t_d26799ff3ae1",
      "si": 1,
      "oi": 3,
      "relPath": "X/X63/X63n1245.xml",
      "kwicHead": "參頭以下起身近前云。",
      "masterName": null
    },
    {
      "class": "occ-remove-retired",
      "entry": "t_d7725cb0c8c0",
      "si": 1,
      "oi": 1,
      "relPath": "X/X63/X63n1245.xml",
      "kwicHead": "冬年人事巡寮迎接請知事第三卷監院維那典座直歲下知",
      "masterName": null
    },
    {
      "class": "occ-remove-retired",
      "entry": "t_d7725cb0c8c0",
      "si": 1,
      "oi": 3,
      "relPath": "T/T48/T48n2023.xml",
      "kwicHead": "客。為眾僧請召故有侍者。為眾僧看守衣鉢故有寮主。",
      "masterName": null
    },
    {
      "class": "occ-remove-retired",
      "entry": "t_dc24f92ead78",
      "si": 1,
      "oi": 3,
      "relPath": "X/X63/X63n1245.xml",
      "kwicHead": "右手仰把笠緣當右肩提之。拄杖之法。有枝者為觸頭。",
      "masterName": null
    },
    {
      "class": "occ-remove-retired",
      "entry": "t_e52f4bdc4110",
      "si": 1,
      "oi": 4,
      "relPath": "T/T48/T48n2023.xml",
      "kwicHead": "如是。院門今日幹甚事。是與不是住持人當一一處斷。",
      "masterName": "Sixin Wuxin"
    },
    {
      "class": "occ-remove-retired",
      "entry": "t_e9adcb470950",
      "si": 1,
      "oi": 6,
      "relPath": "X/X63/X63n1245.xml",
      "kwicHead": "既受聲聞戒。應受菩薩戒。此入法之漸也。",
      "masterName": null
    },
    {
      "class": "occ-remove-retired",
      "entry": "t_ea85b794ca42",
      "si": 1,
      "oi": 2,
      "relPath": "X/X63/X63n1245.xml",
      "kwicHead": "作大字。刻梓以傳。收者幸鑒。嘉泰壬戌虞八宣教謹咨",
      "masterName": null
    },
    {
      "class": "occ-remove-retired",
      "entry": "t_ef5beb628603",
      "si": 1,
      "oi": 3,
      "relPath": "X/X63/X63n1245.xml",
      "kwicHead": "。不過十數下而已。不虞之事不可不慎。如發遣行者出",
      "masterName": null
    },
    {
      "class": "occ-remove-retired",
      "entry": "t_ef5beb628603",
      "si": 1,
      "oi": 4,
      "relPath": "T/T48/T48n2023.xml",
      "kwicHead": "眾僧迎待檀越故有知客。為眾僧請召故有侍者。為眾僧",
      "masterName": null
    },
    {
      "class": "occ-remove-retired",
      "entry": "t_f0cb4dcfc70c",
      "si": 1,
      "oi": 1,
      "relPath": "X/X63/X63n1245.xml",
      "kwicHead": "住持人。亦當詣寮迴禮。若欲掛搭。歇一兩日。詣堂司",
      "masterName": null
    },
    {
      "class": "occ-remove-retired",
      "entry": "t_f0cb4dcfc70c",
      "si": 1,
      "oi": 2,
      "relPath": "X/X63/X63n1245.xml",
      "kwicHead": "掛搭了。如堂中有函櫃。即收行李安函櫃中鏁之。",
      "masterName": null
    },
    {
      "class": "occ-remove-retired",
      "entry": "t_f26addce7844",
      "si": 1,
      "oi": 3,
      "relPath": "X/X63/X63n1245.xml",
      "kwicHead": "。大展三拜。收坐具。從首座位巡堂一匝。却到聖僧前",
      "masterName": null
    },
    {
      "class": "occ-remove-retired",
      "entry": "t_f5e1fe96407c",
      "si": 1,
      "oi": 1,
      "relPath": "X/X63/X63n1245.xml",
      "kwicHead": "四知事赴參。",
      "masterName": null
    },
    {
      "class": "occ-remove-retired",
      "entry": "t_f9bb8b44b32f",
      "si": 1,
      "oi": 1,
      "relPath": "X/X63/X63n1245.xml",
      "kwicHead": "維那典座直歲下知事請頭首首座書狀藏主第四卷知客庫",
      "masterName": null
    },
    {
      "class": "occ-remove-retired",
      "entry": "t_fe03a2a24e00",
      "si": 1,
      "oi": 4,
      "relPath": "X/X63/X63n1245.xml",
      "kwicHead": "監院維那典座直歲下知事",
      "masterName": null
    }
  ],
